# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Same random string you enter in the GitHub webhook "Secret" field
GITHUB_WEBHOOK_SECRET=
# HTTP port for the GitHub webhook endpoint (Railway sets this automatically)
PORT=3000
# SQLite file location. On Railway, mount a volume at /data and use /data/bot.db
DATABASE_PATH=./data/bot.db
# NEIS Open API key from open.neis.go.kr (optional; without it /시간표 shows only up to 5교시)
NEIS_API_KEY=
# GitHub App OAuth (only for apps created before /setup stored them)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public https URL of the bot (Railway sets RAILWAY_PUBLIC_DOMAIN, so usually not needed)
PUBLIC_URL=
