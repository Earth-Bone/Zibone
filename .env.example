# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Same random string you enter in the GitHub webhook "Secret" field
GITHUB_WEBHOOK_SECRET=
# HTTP port for the GitHub webhook endpoint (Railway sets this automatically)
PORT=3000
# SQLite file location. On Railway, mount a volume at /data and use /data/bot.db
DATABASE_PATH=./data/bot.db
# Re-mention reviewers when a PR has had no activity for this many hours (0 disables reminders)
REMINDER_HOURS=24
# Only send reminders between these hours (inclusive start, exclusive end), in TIMEZONE
REMINDER_START_HOUR=9
REMINDER_END_HOUR=22
TIMEZONE=Asia/Seoul
